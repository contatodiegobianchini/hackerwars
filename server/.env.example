# Server configuration. The server does not read .env files by itself: copy this to server/.env and load it
# into your shell before starting (set -a; source server/.env; set +a). Never commit real values.

# Postgres connection string (required). Tables are created on first boot.
# Local example: docker run --name hackerwars-db -e POSTGRES_PASSWORD=dev -p 5432:5432 -d postgres:16
DATABASE_URL=postgres://postgres:dev@127.0.0.1:5432/postgres

# At least 32 random characters (required) and at least 20 characters for the admin account (required).
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Port the server listens on (default 10000).
PORT=10000

# Public URL of the frontend, used for CORS (and as the redirect base for CyberCoins checkout).
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173

# CyberCoins shop (optional: the shop stays disabled without these). Use Stripe TEST keys while developing.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
